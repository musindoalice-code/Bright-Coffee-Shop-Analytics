{
  "datasets": [
    {
      "name": "cc8e594d",
      "displayName": "Coffee Shop Sales",
      "queryLines": [
        "SELECT\n",
        "  transaction_id,\n",
        "  transaction_date AS date,\n",
        "  DATE_FORMAT(transaction_date, 'yyyy-MM') AS month,\n",
        "  DATE_FORMAT(transaction_date, 'MMMM') AS month_name,\n",
        "  DATE_FORMAT(transaction_date, 'EEEE') AS day_name,\n",
        "  store_location AS store,\n",
        "  product_type,\n",
        "  transaction_qty AS units_sold,\n",
        "  total_amount AS revenue,\n",
        "  HOUR(transaction_time) AS hour,\n",
        "  CONCAT(\n",
        "    DATE_FORMAT(transaction_time, 'HH'),\n",
        "    ':',\n",
        "    CASE\n",
        "      WHEN MINUTE(transaction_time) < 30 THEN '00'\n",
        "      ELSE '30'\n",
        "    END\n",
        "  ) AS time_interval,\n",
        "  CASE\n",
        "    WHEN\n",
        "      LOWER(product_type) LIKE '%coffee%'\n",
        "      OR LOWER(product_type) LIKE '%espresso%'\n",
        "    THEN\n",
        "      'Coffee'\n",
        "    WHEN\n",
        "      LOWER(product_type) LIKE '%tea%'\n",
        "      OR LOWER(product_type) LIKE '%chai%'\n",
        "    THEN\n",
        "      'Tea'\n",
        "    WHEN LOWER(product_type) LIKE '%chocolate%' THEN 'Chocolate'\n",
        "    WHEN\n",
        "      LOWER(product_type) LIKE '%scone%'\n",
        "      OR LOWER(product_type) LIKE '%sandwich%'\n",
        "      OR LOWER(product_type) LIKE '%pastry%'\n",
        "      OR LOWER(product_type) LIKE '%cake%'\n",
        "      OR LOWER(product_type) LIKE '%cookie%'\n",
        "      OR LOWER(product_type) LIKE '%muffin%'\n",
        "    THEN\n",
        "      'Food'\n",
        "    ELSE 'Other'\n",
        "  END AS category\n",
        "FROM\n",
        "  bright_coffee_sales_clean"
      ],
      "parameters": [
        {
          "displayName": "param_1",
          "keyword": "param_1",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "insights_summary",
      "displayName": "Insights Summary",
      "queryLines": [
        "WITH revenue_metrics AS (\n",
        "  SELECT\n",
        "    SUM(total_amount) AS total_revenue,\n",
        "    COUNT(DISTINCT transaction_id) AS total_transactions,\n",
        "    AVG(total_amount) AS avg_transaction,\n",
        "    SUM(transaction_qty) AS total_units\n",
        "  FROM\n",
        "    bright_coffee_sales_clean\n",
        "),\n",
        "category_performance AS (\n",
        "  SELECT\n",
        "    CASE\n",
        "      WHEN\n",
        "        LOWER(product_type) LIKE '%coffee%'\n",
        "        OR LOWER(product_type) LIKE '%espresso%'\n",
        "      THEN\n",
        "        'Coffee'\n",
        "      WHEN\n",
        "        LOWER(product_type) LIKE '%tea%'\n",
        "        OR LOWER(product_type) LIKE '%chai%'\n",
        "      THEN\n",
        "        'Tea'\n",
        "      WHEN LOWER(product_type) LIKE '%chocolate%' THEN 'Chocolate'\n",
        "      WHEN\n",
        "        LOWER(product_type) LIKE '%scone%'\n",
        "        OR LOWER(product_type) LIKE '%sandwich%'\n",
        "        OR LOWER(product_type) LIKE '%pastry%'\n",
        "        OR LOWER(product_type) LIKE '%cake%'\n",
        "        OR LOWER(product_type) LIKE '%cookie%'\n",
        "        OR LOWER(product_type) LIKE '%muffin%'\n",
        "      THEN\n",
        "        'Food'\n",
        "      ELSE 'Other'\n",
        "    END AS category,\n",
        "    SUM(total_amount) AS revenue,\n",
        "    COUNT(*) AS transactions\n",
        "  FROM\n",
        "    bright_coffee_sales_clean\n",
        "  GROUP BY\n",
        "    category\n",
        "  ORDER BY\n",
        "    revenue DESC\n",
        "),\n",
        "peak_hours AS (\n",
        "  SELECT\n",
        "    HOUR(transaction_time) AS hour,\n",
        "    SUM(total_amount) AS revenue,\n",
        "    COUNT(*) AS transactions\n",
        "  FROM\n",
        "    bright_coffee_sales_clean\n",
        "  GROUP BY\n",
        "    hour\n",
        "  ORDER BY\n",
        "    revenue DESC\n",
        "  LIMIT 3\n",
        "),\n",
        "store_rankings AS (\n",
        "  SELECT\n",
        "    store_location,\n",
        "    SUM(total_amount) AS revenue,\n",
        "    COUNT(DISTINCT transaction_id) AS transactions,\n",
        "    RANK() OVER (ORDER BY SUM(total_amount) DESC) AS revenue_rank\n",
        "  FROM\n",
        "    bright_coffee_sales_clean\n",
        "  GROUP BY\n",
        "    store_location\n",
        ")\n",
        "SELECT\n",
        "  'summary' AS metric_type,\n",
        "  CAST(total_revenue AS STRING) AS value,\n",
        "  'Total Revenue' AS metric_name\n",
        "FROM\n",
        "  revenue_metrics\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'summary',\n",
        "  CAST(total_transactions AS STRING),\n",
        "  'Total Transactions'\n",
        "FROM\n",
        "  revenue_metrics\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'summary',\n",
        "  CAST(ROUND(avg_transaction, 2) AS STRING),\n",
        "  'Avg Transaction Value'\n",
        "FROM\n",
        "  revenue_metrics\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'top_category',\n",
        "  category,\n",
        "  CAST(ROUND(revenue, 2) AS STRING)\n",
        "FROM\n",
        "  category_performance\n",
        "LIMIT 1"
      ]
    }
  ],
